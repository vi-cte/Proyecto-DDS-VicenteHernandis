<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="28.0" styleClass="dialog-root" stylesheets="@MainMenu.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.votify.frontend.controller.CreateEventDialogController">
    <padding>
        <Insets bottom="40.0" left="42.0" right="42.0" top="40.0" />
    </padding>
    <children>
        <VBox alignment="CENTER" spacing="8.0">
            <children>
                <Label fx:id="dialogTitle" styleClass="about-title" text="Crear nuevo evento" />
                <Label fx:id="dialogSubtitle" styleClass="vote-subtitle" text="Define los parámetros básicos para el nuevo evento" />
            </children>
        </VBox>
          <VBox spacing="6.0">
              <children>
                  <Label styleClass="field-label" text="Nombre del evento" />
                  <TextField fx:id="nameField" promptText="Ej: Hackathon de Innovación" styleClass="input-field" />
              </children>
          </VBox>
          <VBox spacing="6.0">
              <children>
                  <Label styleClass="field-label" text="Fecha del evento" />
                  <DatePicker fx:id="eventDatePicker" maxWidth="1.7976931348623157E308" styleClass="input-field" />
              </children>
          </VBox>
          <VBox spacing="6.0">
              <children>
                  <Label styleClass="field-label" text="Descripción" />
                  <TextArea fx:id="descriptionArea" prefRowCount="3" promptText="Breve descripción del evento" styleClass="input-field" wrapText="true" />
              </children>
          </VBox>
      <HBox spacing="40.0">
         <children>
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <children>
                        <CheckBox fx:id="registrationsToggle" mnemonicParsing="false" onAction="#onRegistrationToggle" styleClass="settings-toggle" />
                        <Label styleClass="field-label" text="Inscripciones" />
                        <Label fx:id="registrationsLabel" styleClass="settings-status-label" text="Cerradas" />
                    </children>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <children>
                        <CheckBox fx:id="votingToggle" mnemonicParsing="false" onAction="#onVotingToggle" styleClass="settings-toggle" />
                        <Label styleClass="field-label" text="Votaciones" />
                        <Label fx:id="votingLabel" styleClass="settings-status-label" text="Cerradas" />
                    </children>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <children>
                        <CheckBox fx:id="resultsToggle" mnemonicParsing="false" onAction="#updateLabels" styleClass="settings-toggle" />
                        <Label styleClass="field-label" text="Resultados" />
                        <Label fx:id="resultsLabel" styleClass="settings-status-label" text="Ocultos" />
                    </children>
                </HBox>
         </children>
      </HBox>
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
                  <Label styleClass="field-label" text="Máximo de votos por usuario" />
                  <TextField fx:id="maxVotesField" prefHeight="33.0" prefWidth="89.0" promptText="3" styleClass="settings-number-field" text="3" />
         </children>
      </HBox>
      <HBox spacing="40.0">
         <children>
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <children>
                        <CheckBox fx:id="juryToggle" mnemonicParsing="false" onAction="#updateLabels" styleClass="settings-toggle" />
                        <Label styleClass="field-label" text="Jurado" />
                        <Label fx:id="juryLabel" styleClass="settings-status-label" text="Desactivado" />
                    </children>
                </HBox>
            <HBox alignment="CENTER_LEFT" prefHeight="56.0" prefWidth="435.0" spacing="10.0">
               <children>
                        <Label styleClass="field-label" text="Modo de voto del jurado" />
                        <ComboBox fx:id="juryVotingModeComboBox" maxWidth="1.7976931348623157E308" prefHeight="56.0" prefWidth="220.0" styleClass="input-field" />
               </children>
            </HBox>
         </children>
      </HBox>
        <HBox alignment="CENTER_RIGHT" spacing="14.0">
            <children>
                <Button fx:id="deleteButton" managed="false" mnemonicParsing="false" onAction="#deleteEvent" styleClass="delete-button" text="Eliminar evento" visible="false" />
                <Button fx:id="archiveButton" managed="false" mnemonicParsing="false" onAction="#archiveEvent" styleClass="admin-secondary-button" text="Archivar evento" visible="false" />
                <Button fx:id="actionButton" mnemonicParsing="false" onAction="#createEvent" styleClass="action-button" text="Crear evento" />
            </children>
        </HBox>
    </children>
</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="12.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.votify.frontend.controller.VotingFormController">
   <children>
      <Label text="Emitir votos">
         <font>
            <Font name="Arial Bold" size="20.0" />
         </font>
      </Label>
      <Label fx:id="hintLabel" text="Elige hasta 3 participantes diferentes. Puedes dejar opciones en blanco." />
      <VBox spacing="8.0">
         <children>
            <Label text="Opcion 1 (opcional)" />
            <ComboBox fx:id="firstChoice" prefWidth="280.0" />
            <Label text="Opcion 2 (opcional)" />
            <ComboBox fx:id="secondChoice" prefWidth="280.0" />
            <Label text="Opcion 3 (opcional)" />
            <ComboBox fx:id="thirdChoice" prefWidth="280.0" />
         </children>
      </VBox>
      <HBox spacing="10.0">
         <children>
            <Button fx:id="submitButton" defaultButton="true" onAction="#submitVote" text="Enviar voto" />
            <Button cancelButton="true" onAction="#closeWindow" text="Cancelar" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
   </padding>
</VBox>

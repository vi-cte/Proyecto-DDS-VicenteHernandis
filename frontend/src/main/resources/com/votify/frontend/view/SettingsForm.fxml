<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.shape.SVGPath?>

<VBox spacing="20.0" styleClass="settings-root" stylesheets="@MainMenu.css" prefWidth="420.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.votify.frontend.controller.SettingsFormController">
    <HBox alignment="TOP_RIGHT">
        <Button mnemonicParsing="false" onAction="#close" styleClass="icon-button">
            <graphic>
                <SVGPath styleClass="icon-button-svg" content="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12 19 6.41z"/>
            </graphic>
        </Button>
    </HBox>

    <VBox spacing="5.0" styleClass="settings-header">
        <Label text="Configuración del evento" styleClass="settings-title" />
        <Label text="Gestiona las opciones de votación y el estado del evento" styleClass="settings-subtitle" wrapText="true" />
    </VBox>

    <VBox spacing="18.0">
        <HBox alignment="CENTER_LEFT" styleClass="settings-row">
            <VBox HBox.hgrow="ALWAYS">
                <Label text="Inscripciones" styleClass="settings-label" />
                <Label fx:id="registrationStatusLabel" text="Abiertas" styleClass="settings-status" />
            </VBox>
            <CheckBox fx:id="registrationToggle" styleClass="toggle-switch" onAction="#onRegistrationToggle" />
        </HBox>

        <HBox alignment="CENTER_LEFT" styleClass="settings-row">
            <VBox HBox.hgrow="ALWAYS">
                <Label text="Votaciones" styleClass="settings-label" />
                <Label fx:id="votingStatusLabel" text="Cerradas" styleClass="settings-status" />
            </VBox>
            <CheckBox fx:id="votingToggle" styleClass="toggle-switch" onAction="#onVotingToggle" />
        </HBox>

        <HBox alignment="CENTER_LEFT" styleClass="settings-row">
            <VBox HBox.hgrow="ALWAYS">
                <Label text="Resultados" styleClass="settings-label" />
                <Label fx:id="resultsStatusLabel" text="Ocultos" styleClass="settings-status" />
            </VBox>
            <CheckBox fx:id="resultsToggle" styleClass="toggle-switch" onAction="#onResultsToggle" />
        </HBox>

        <VBox spacing="8.0" styleClass="settings-field-section">
            <Label text="Número de votos por persona" styleClass="settings-label" />
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <TextField fx:id="maxVotesField" text="1" prefWidth="70.0" styleClass="settings-number-field" />
                <Label text="voto" styleClass="settings-subtitle" />
            </HBox>
        </VBox>

        <VBox spacing="8.0" styleClass="settings-field-section">
            <Label text="Modo de votación del jurado" styleClass="settings-label" />
            <ComboBox fx:id="juryVotingModeComboBox" maxWidth="1.7976931348623157E308" styleClass="input-field" />
        </VBox>

        <VBox spacing="10.0" styleClass="settings-reset-section">
            <Label text="Reiniciar evento" styleClass="settings-label" />
            <Label text="Se eliminarán todos los equipos participantes y todos los votos" styleClass="settings-status" wrapText="true" />
            <Button mnemonicParsing="false" onAction="#resetEvent" text="Reiniciar evento" styleClass="danger-button" maxWidth="Infinity" />
        </VBox>
    </VBox>
</VBox>

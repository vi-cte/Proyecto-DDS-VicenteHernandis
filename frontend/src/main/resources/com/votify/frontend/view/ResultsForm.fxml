<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane prefHeight="768.0" prefWidth="1365.0" stylesheets="@MainMenu.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.votify.frontend.controller.ResultsFormController">
   <top>
      <VBox>
         <children>
            <HBox alignment="CENTER_LEFT" prefHeight="100.0" spacing="18.0" styleClass="top-bar">
               <padding>
                  <Insets bottom="16.0" left="30.0" right="38.0" top="16.0" />
               </padding>
               <children>
                  <VBox spacing="1.0" styleClass="brand-block">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="9.0">
                           <children>
                              <ImageView fitHeight="70.0" fitWidth="250.0" pickOnBounds="true" preserveRatio="true" styleClass="brand-logo">
                                 <image>
                                    <Image url="@Logo%20Votify.png" />
                                 </image>
                              </ImageView>
                           </children>
                        </HBox>
                     </children>
                  </VBox>
                  <Region HBox.hgrow="ALWAYS" />
                  <HBox alignment="CENTER_RIGHT" spacing="14.0">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="user-pill">
                           <children>
                              <StackPane prefHeight="44.0" prefWidth="44.0" styleClass="user-avatar">
                                 <children>
                                    <SVGPath content="M12 12.1C13.7 12.1 15.05 10.72 15.05 9.03C15.05 7.34 13.7 5.96 12 5.96C10.3 5.96 8.95 7.34 8.95 9.03C8.95 10.72 10.3 12.1 12 12.1ZM12 13.63C9.23 13.63 6.95 15.91 6.95 18.68V19.45C6.95 19.87 7.28 20.2 7.7 20.2H8.47C8.89 20.2 9.22 19.87 9.22 19.45V18.68C9.22 17.16 10.48 15.9 12 15.9C13.52 15.9 14.78 17.16 14.78 18.68V19.45C14.78 19.87 15.11 20.2 15.53 20.2H16.3C16.72 20.2 17.05 19.87 17.05 19.45V18.68C17.05 15.91 14.77 13.63 12 13.63Z" styleClass="user-avatar-icon" />
                                 </children>
                              </StackPane>
                              <VBox spacing="2.0">
                                 <children>
                                    <Label styleClass="user-greeting" text="Bienvenido" />
                                    <Label styleClass="user-name" text="Juan Pérez" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                        <Button mnemonicParsing="false" onAction="#exit" styleClass="logout-button" text="Salir">
                           <graphic>
                              <SVGPath content="M7.3 5.5H11.3V7.1H8.9V16.9H11.3V18.5H7.3V5.5ZM12.8 8.0L17.8 12.0L12.8 16.0V13.5H9.9V10.5H12.8V8.0Z" styleClass="logout-icon" />
                           </graphic>
                        </Button>
                     </children>
                  </HBox>
               </children>
            </HBox>
            <VBox spacing="8.0" style="-fx-padding: 26 38 0 38;">
               <children>
                  <HBox alignment="CENTER_LEFT">
                     <children>
                        <Button mnemonicParsing="false" onAction="#closeResults" style="-fx-background-color: #ffffff; -fx-text-fill: #162642; -fx-font-size: 14px; -fx-font-weight: 700; -fx-padding: 8 12 8 12; -fx-background-radius: 12; -fx-border-color: #d8e0ea; -fx-border-radius: 12; -fx-border-width: 1; -fx-cursor: hand;" text="Volver" />
                        <Region HBox.hgrow="ALWAYS" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </VBox>
   </top>
   <center>
      <ScrollPane fitToHeight="true" fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent; -fx-control-inner-background: transparent; -fx-border-color: transparent; -fx-padding: 0;">
         <content>
            <VBox alignment="TOP_CENTER" spacing="18.0">
               <children>
                  <VBox alignment="TOP_CENTER" maxWidth="800.0" spacing="24.0" VBox.vgrow="ALWAYS">
                     <children>
                        <VBox alignment="TOP_CENTER" spacing="4.0">
                           <children>
                              <Label style="-fx-font-size: 24px;" styleClass="page-title" text="Resultados de la Votación" />
                              <Label fx:id="summaryLabel" style="-fx-font-size: 14px;" styleClass="page-subtitle" text="Votos totales: 0" />
                           </children>
                        </VBox>
                        <VBox spacing="16.0" style="-fx-background-color: #ffffff; -fx-background-radius: 16; -fx-border-color: transparent; -fx-border-radius: 16; -fx-effect: dropshadow(gaussian, rgba(29, 54, 95, 0.07), 16, 0.12, 0, 3);" VBox.vgrow="ALWAYS">
                           <padding>
                              <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
                           </padding>
                           <children>
                              <TextArea fx:id="resultsArea" editable="false" prefRowCount="18" style="-fx-padding: 10; -fx-background-color: #f7f9fc; -fx-border-color: #d7e0eb; -fx-border-radius: 8; -fx-background-radius: 8; -fx-text-fill: #162642; -fx-font-size: 15px; -fx-font-family: 'Consolas';" wrapText="true" VBox.vgrow="ALWAYS" />
                           </children>
                        </VBox>
                     </children>
                  </VBox>
               </children>
               <padding>
                  <Insets bottom="38.0" left="38.0" right="38.0" top="18.0" />
               </padding>
            </VBox>
         </content>
      </ScrollPane>
   </center>
</BorderPane>
